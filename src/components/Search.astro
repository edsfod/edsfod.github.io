---
import { t } from '../i18n/ui';
---

<dialog class="search" aria-label={t['nav.search']}>
  <form method="dialog" class="box" role="search">
    <input type="search" placeholder={t['search.placeholder']} aria-label={t['search.placeholder']} autocomplete="off" spellcheck="false" />
    <ol class="results" role="listbox"></ol>
    <p class="hint meta">{t['search.hint']}　↑↓ 选择，Enter 打开</p>
  </form>
</dialog>

<script>
  import { t } from '../i18n/ui';

  type Result = { url: string; meta: { title?: string }; excerpt: string };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (q: string, opts?: object, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLOListElement>('.results')!;
  let pagefind: Pagefind | null = null;
  let active = -1;

  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      const path = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
      await pagefind.init();
    } catch {
      list.innerHTML = `<li class="empty">${t['search.unavailable']}</li>`;
    }
    return pagefind;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  }

  function setActive(i: number) {
    const items = [...list.querySelectorAll<HTMLAnchorElement>('a')];
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((a, j) => a.setAttribute('aria-selected', String(j === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', async () => {
    const q = input.value.trim();
    const pf = await load();
    if (!pf) return;
    if (!q) {
      list.innerHTML = '';
      return;
    }
    const search = await pf.debouncedSearch(q, {}, 200);
    if (!search) return; // 被更新的输入取代
    const data = await Promise.all(search.results.slice(0, 12).map((r) => r.data()));
    active = -1;
    list.innerHTML = data.length
      ? data
          .map(
            (d) =>
              `<li><a href="${d.url}" role="option"><strong>${d.meta.title ?? d.url}</strong><span>${d.excerpt}</span></a></li>`,
          )
          .join('')
      : `<li class="empty">没有找到“${q.replace(/[<>&"]/g, '')}”</li>`;
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const target = list.querySelectorAll<HTMLAnchorElement>('a')[Math.max(active, 0)];
      if (target) location.href = target.href;
    }
  });

  // 点遮罩关闭
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const el = document.activeElement as HTMLElement | null;
    const typing = el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
    if (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search {
    width: min(100% - 2rem, 40rem);
    max-height: min(80vh, 40rem);
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
  }
  .search::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  input {
    font: inherit;
    font-size: 1.0625rem;
    padding: 0.9rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: inherit;
    outline: none;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
  }
  .results :global(a) {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    color: var(--fg);
  }
  .results :global(a:hover),
  .results :global(a[aria-selected='true']) {
    background: var(--bg-soft);
    text-decoration: none;
  }
  .results :global(strong) {
    display: block;
    font-weight: 600;
  }
  .results :global(span) {
    display: block;
    font-size: 0.875rem;
    color: var(--fg-soft);
    line-height: 1.6;
  }
  .results :global(.empty) {
    padding: 0.75rem;
    color: var(--fg-soft);
    font-size: 0.9375rem;
  }
  .results:empty {
    display: none;
  }
  .hint {
    margin: 0;
    padding: 0.5rem 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
  }
</style>
