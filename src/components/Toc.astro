---
// 目录：收录 ## ~ ####，按 <html data-toc="2|3|4"> 显示到相应层级（详细程度可切换并记住）
import type { MarkdownHeading } from 'astro';
import { t } from '../i18n/ui';

interface Props {
  headings: MarkdownHeading[];
  /** side：右侧栏，带详细程度切换；inline：窄屏时放在正文上方 */
  variant?: 'side' | 'inline';
  /** 追加在目录末尾的一级条目，例如评论区 */
  extra?: { slug: string; text: string }[];
}
const { variant = 'side', extra = [] } = Astro.props;
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 4 && h.slug !== 'footnote-label');
const items = [...headings, ...extra.map((e) => ({ depth: 2, slug: e.slug, text: e.text, extra: true }))];
const maxDepth = Math.max(2, ...headings.map((h) => h.depth));
const levels = [
  { depth: 2, label: '简略' },
  { depth: 3, label: '标准' },
  { depth: 4, label: '详细' },
].filter((l) => l.depth <= maxDepth);
---

{
  items.length > 0 && (
    <nav class:list={['toc', `toc--${variant}`]} aria-label={t['post.toc']}>
      {variant === 'side' ? (
        <>
          {levels.length > 1 && (
            <div class="levels" role="radiogroup" aria-label="目录详细程度">
              {levels.map((l) => (
                <button type="button" role="radio" data-toc-level={l.depth} title={`显示到 ${'#'.repeat(l.depth)} 级标题`}>
                  {l.label}
                </button>
              ))}
            </div>
          )}
          <ol>
            {items.map((h) => (
              <li class:list={[`d${h.depth}`, { extra: 'extra' in h }]} data-depth={h.depth}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <details>
          <summary>{t['post.toc']}</summary>
          <ol>
            {items.map((h) => (
              <li class:list={[`d${h.depth}`, { extra: 'extra' in h }]} data-depth={h.depth}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </nav>
  )
}

<script>
  const root = document.documentElement;

  // 详细程度切换
  const syncLevel = () => {
    const level = root.dataset.toc ?? '3';
    document.querySelectorAll<HTMLButtonElement>('[data-toc-level]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.tocLevel === level));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-toc-level]').forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.toc = b.dataset.tocLevel!;
      localStorage.setItem('tocLevel', b.dataset.tocLevel!);
      syncLevel();
    }),
  );
  syncLevel();

  // 高亮当前阅读到的章节（各层级都会高亮，隐藏层级时其上级仍高亮）
  const anchors = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const depthById = new Map(anchors.map((a) => [decodeURIComponent(a.hash.slice(1)), Number(a.parentElement?.dataset.depth ?? 2)]));
  const headings = [...depthById.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (headings.length) {
    const depthOf = (h: HTMLElement) => depthById.get(h.id) ?? 2;
    const update = () => {
      let idx = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < innerHeight * 0.3) idx = i;
      });
      // 当前标题及其各级祖先
      const active = new Set<string>();
      let depth = 99;
      for (let i = idx; i >= 0; i--) {
        const d = depthOf(headings[i]);
        if (d < depth) {
          active.add(headings[i].id);
          depth = d;
        }
      }
      anchors.forEach((a) => {
        const id = decodeURIComponent(a.hash.slice(1));
        if (id === headings[idx].id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        a.classList.toggle('ancestor', active.has(id) && id !== headings[idx].id);
      });
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .toc {
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 条目内折行的行距要明显小于条目之间的间距，否则一条长标题看起来像两条 */
  li {
    padding: 0.22rem 0;
  }
  .d3 {
    padding-left: 0.9em;
  }
  .d4 {
    padding-left: 1.8em;
    font-size: 0.95em;
  }
  /* 按详细程度隐藏更深的层级 */
  :global(:root[data-toc='2']) .toc--side :is(.d3, .d4),
  :global(:root[data-toc='3']) .toc--side .d4 {
    display: none;
  }
  a {
    display: block;
    color: var(--fg-soft);
    border-left: 2px solid transparent;
    padding-left: 0.6rem;
  }
  a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  a.ancestor {
    color: var(--fg);
  }
  a[aria-current='true'] {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  /* 隐藏层级里的当前标题不可见时，让其上级显示强调色 */
  :global(:root[data-toc='2']) .toc--side .d2 a.ancestor,
  :global(:root[data-toc='3']) .toc--side :is(.d2, .d3) a.ancestor {
    border-left-color: var(--border);
  }
  /* 评论等追加条目：与标题之间留一道分隔 */
  li.extra {
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px dashed var(--border);
  }
  li.extra + li.extra {
    margin-top: 0;
    border-top: 0;
  }
  .levels {
    display: inline-flex;
    margin-bottom: 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .levels button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border: 0;
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
  }
  .levels button + button {
    border-left: 1px solid var(--border);
  }
  .levels button[aria-checked='true'] {
    background: var(--bg-soft);
    color: var(--fg);
    font-weight: 600;
  }
  .toc--inline summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fg-soft);
    margin-bottom: 0.4rem;
  }
</style>
