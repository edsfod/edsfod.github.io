---
import { site } from '../site.config';
import { t } from '../i18n/ui';

const nav = [
  { href: '/', label: t['nav.home'] },
  { href: '/archive/', label: t['nav.archive'] },
  { href: '/series/', label: t['nav.series'] },
  { href: '/tags/', label: t['nav.tags'] },
  { href: '/about/', label: t['nav.about'] },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">{site.title}</a>
    <nav aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="actions">
      <button type="button" class="icon-btn" data-search-open aria-label={t['nav.search']} title={`${t['nav.search']}（/）`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path
            d="m20 20-3.5-3.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path></svg
        >
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label={t['theme.toggle']} title={t['theme.toggle']}>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"
          ></path></svg
        >
      </button>
      <a class="icon-btn" href="/rss.xml" aria-label={t['nav.rss']} title={t['nav.rss']}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path><circle cx="6" cy="18" r="1.6" fill="currentColor"></circle></svg
        >
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  /* 电脑上页头固定在顶部；手机上不固定，省出屏幕高度 */
  @media (min-width: 641px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--bg);
    }
    .bar {
      height: var(--header-h);
      flex-wrap: nowrap;
      padding-block: 0;
    }
  }
  /* 电脑：页头内容与正文栏对齐（左右让出侧栏宽度，再按正文宽度居中），随侧栏折叠一起移动 */
  @media (min-width: 1100px) {
    .site-header {
      padding-left: var(--left-w);
      padding-right: var(--right-w);
      transition: padding 0.2s ease;
    }
    .site-header .bar {
      width: min(100% - 4rem, var(--content-max));
    }
  }
  .bar {
    width: min(100% - 2.5rem, var(--measure));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--fg);
    letter-spacing: 0.01em;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  nav {
    flex: 1;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--fg-soft);
    font-size: 0.9375rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    font-weight: 600;
  }
  .actions {
    display: flex;
    gap: 0.25rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg-soft);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--bg-soft);
    color: var(--fg);
  }
  :global(:root[data-theme='dark']) .sun,
  :global(:root[data-theme='light']) .moon {
    display: none;
  }
  @media (max-width: 640px) {
    nav {
      order: 3;
      flex-basis: 100%;
    }
    .actions {
      margin-left: auto;
    }
  }
</style>
