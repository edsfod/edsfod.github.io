---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** 显示序号（专栏页） */
  numbered?: boolean;
}
const { posts, numbered = false } = Astro.props;
---

<ol class:list={['post-list', { numbered }]}>
  {
    posts.map((p, i) => (
      <li>
        {numbered ? <span class="num">{p.data.order ?? i + 1}</span> : <FormattedDate date={p.data.published} />}
        <a href={`/posts/${p.id}/`}>{p.data.title}</a>
        {p.data.ai && (
          <span class="badge" title="AI 参与撰写">
            AI
          </span>
        )}
        {p.data.draft && <span class="badge">草稿</span>}
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
  }
  li :global(time),
  .num {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-size: 0.875rem;
    color: var(--fg-faint);
    min-width: 5.6em;
  }
  .num {
    min-width: 1.5em;
    text-align: right;
  }
  a {
    color: var(--fg);
  }
  a:hover {
    color: var(--accent);
  }
  .badge {
    flex: none;
    font-size: 0.6875rem;
    line-height: 1.6;
    padding: 0 0.4em;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--fg-faint);
  }
  @media (max-width: 480px) {
    li {
      flex-wrap: wrap;
      gap: 0 0.75rem;
    }
    li :global(time) {
      flex-basis: 100%;
    }
  }
</style>
