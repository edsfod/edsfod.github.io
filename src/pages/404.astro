---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---

<Base title={t['notFound.title']} noindex>
  <div class="container">
    <h1 class="page-title">404 · {t['notFound.title']}</h1>
    <p>可以按 <kbd>/</kbd> 搜索，或 <a href="/">{t['notFound.back']}</a>。</p>
  </div>
</Base>
