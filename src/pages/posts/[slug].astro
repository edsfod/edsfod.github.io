---
import { getEntry, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { backlinksOf, getPosts, postsInSeries, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

// 专栏：专栏内翻页；否则按时间翻页
let series;
let prev: Post | undefined;
let next: Post | undefined;
if (post.data.series) {
  const entry = await getEntry(post.data.series);
  const list = postsInSeries(posts, post.data.series.id);
  const i = list.findIndex((p) => p.id === post.id);
  series = { entry: entry!, index: i + 1, total: list.length };
  prev = list[i - 1];
  next = list[i + 1];
} else {
  const i = posts.findIndex((p) => p.id === post.id);
  next = posts[i - 1]; // 更新的一篇
  prev = posts[i + 1]; // 更早的一篇
}
const link = (p?: Post) => (p ? { href: `/posts/${p.id}/`, title: p.data.title } : undefined);

const byId = new Map(posts.map((p) => [p.id, p]));
const from = post.data.from.map((r) => byId.get(r.id)).filter((p): p is Post => Boolean(p));
---

<Article
  entry={post}
  headings={headings}
  words={remarkPluginFrontmatter.words}
  series={series}
  prev={link(prev)}
  next={link(next)}
  from={from}
  backlinks={backlinksOf(posts, post)}
  isPost
>
  <Content />
</Article>
