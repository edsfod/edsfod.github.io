---
import 'katex/dist/katex.min.css'; // 字体只在页面真正出现公式时才会下载
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { t } from '../i18n/ui';
import { site } from '../site.config';
import { readingMinutes, tagSlug, updatedOf, type Page, type Post } from '../lib/posts';

type Link = { href: string; title: string };

interface Props {
  entry: Post | Page;
  headings: MarkdownHeading[];
  words?: number;
  series?: { entry: CollectionEntry<'series'>; index: number; total: number };
  prev?: Link;
  next?: Link;
  from?: Post[];
  backlinks?: Post[];
  comments?: boolean;
  /** 文章页显示许可声明与字数；独立页面不显示 */
  isPost?: boolean;
}

const { entry, headings, words, series, prev, next, from = [], backlinks = [], comments = true, isPost = false } = Astro.props;
const data = entry.data;
const post = isPost ? (entry as Post).data : undefined;
const updated = updatedOf(entry);
const ai = data.ai;
const models = ai?.model ? [ai.model].flat().join('、') : undefined;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4 && h.slug !== 'footnote-label');
---

<Base title={data.title} description={data.description} type="article" published={data.published} updated={updated}>
  {
    tocHeadings.length > 0 && (
      <Fragment slot="right">
        <Toc headings={headings} />
        <div class="sidebar-foot">
          <div class="progress" aria-hidden="true">
            <span data-progress-bar />
          </div>
          <div class="foot-row">
            <span class="meta" data-progress-text>
              0%
            </span>
            <button type="button" class="to-top" data-to-top>
              ↑ {t['toTop']}
            </button>
          </div>
        </div>
      </Fragment>
    )
  }
  <div class="container article">
    <header class="head" data-pagefind-body>
      {
        series && (
          <p class="series-banner meta">
            {t['post.series']}<a href={`/series/${series.entry.id}/`}>《{series.entry.data.title}》</a>·{' '}
            {t['post.seriesPart'](series.index, series.total)}
          </p>
        )
      }
      <h1 class="page-title">{data.title}</h1>
      <p class="meta">
        <span>{t['post.published']} <FormattedDate date={data.published} precise /></span>
        {
          updated && (
            <span>
              · {t['post.updated']} <FormattedDate date={updated} precise />
            </span>
          )
        }
        {
          isPost && words !== undefined && (
            <span>
              · {words} {t['post.words']} · {readingMinutes(words)} {t['post.minutes']}
            </span>
          )
        }
        {post?.draft && <span>· {t['post.draft']}</span>}
      </p>
      {
        post && post.tags.length > 0 && (
          <p class="tags">
            {post.tags.map((tag) => (
              <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                #{tag}
              </a>
            ))}
          </p>
        )
      }
      {
        ai && (
          <div class="notice notice--ai" role="note">
            <p>
              {ai.note ?? t['post.ai.default']}
              {models && <>{`${t['post.ai.model']}：${models}。`}</>}
            </p>
          </div>
        )
      }
      {
        data.living && (
          <div class="notice" role="note">
            <p>{t['post.living']}</p>
          </div>
        )
      }
    </header>

    <div class="toc-inline" data-pagefind-ignore>
      <Toc headings={headings} variant="inline" />
    </div>

    <div class="body">
      <div class="prose" data-pagefind-body>
        <slot />
      </div>

      {
        from.length > 0 && (
          <section class="relations">
            <h2 class="section-title">{t['post.from']}</h2>
            <ul>
              {from.map((p) => (
                <li>
                  <a href={`/posts/${p.id}/`}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        backlinks.length > 0 && (
          <section class="relations">
            <h2 class="section-title">{t['post.backlinks']}</h2>
            <ul>
              {backlinks.map((p) => (
                <li>
                  <a href={`/posts/${p.id}/`}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        isPost && (
          <p class="license meta">
            {t['post.license.prefix']}
            <a href={site.license.url} rel="license">
              {site.license.name}
            </a>
            {t['post.license.suffix']}
          </p>
        )
      }

      {
        (prev || next) && (
          <nav class="pager" aria-label="翻页">
            {prev ? (
              <a href={prev.href} rel="prev">
                <small>← {t['post.prev']}</small>
                {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a href={next.href} rel="next" class="next">
                <small>{t['post.next']} →</small>
                {next.title}
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      {comments && <Giscus />}
    </div>
  </div>
</Base>

<script>
  import { t } from '../i18n/ui';

  // 标题锚点：悬停显示 #，点击得到可分享的链接
  document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `链接到“${h.textContent}”`);
    h.appendChild(a);
  });

  // 阅读进度与回到顶部（右侧栏底部）
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const text = document.querySelector<HTMLElement>('[data-progress-text]');
  if (bar && text) {
    const sync = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const pct = max > 0 ? Math.min(100, Math.round((scrollY / max) * 100)) : 100;
      bar.style.width = `${pct}%`;
      text.textContent = `已读 ${pct}%`;
    };
    addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
  document.querySelector('[data-to-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

  // 代码块复制按钮
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = t['code.copy'];
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      btn.textContent = t['code.copied'];
      setTimeout(() => (btn.textContent = t['code.copy']), 1500);
    });
    pre.appendChild(btn);
  });
</script>

<style>
  .head {
    margin-bottom: 1.25rem;
  }
  .body {
    min-width: 0;
  }
  /* 窄屏：目录折叠在正文上方；电脑：目录在右侧栏，这里隐藏 */
  .toc-inline :global(.toc) {
    margin-bottom: 1.25rem;
  }
  @media (min-width: 1100px) {
    .toc-inline {
      display: none;
    }
  }
  /* 右侧栏底部：阅读进度与回到顶部 */
  .sidebar-foot {
    position: sticky;
    bottom: 0;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .progress {
    height: 3px;
    border-radius: 2px;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.4rem;
  }
  .foot-row .meta {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .to-top {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--fg-faint);
    cursor: pointer;
  }
  .to-top:hover {
    color: var(--accent);
  }
  .series-banner {
    margin: 0 0 0.5rem;
  }
  .series-banner a {
    color: var(--fg-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
  }
  .meta span + span {
    margin-left: 0.25em;
  }
  .head .meta {
    margin: 0;
  }
  .relations ul {
    margin: 0;
    padding-left: 1.2em;
  }
  .license {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    line-height: 1.5;
  }
  .pager a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .pager small {
    color: var(--fg-faint);
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
